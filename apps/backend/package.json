{
  "name": "@atlas/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "user:create": "npm run build && node dist/scripts/create-user.js",
    "access:grant": "npm run build && node dist/scripts/grant-access.js",
    "test:access": "npm run build && node --test test/access.test.mjs",
    "test:network": "npm run build && node --test test/network.test.mjs",
    "test:operations": "npm run build && node --test test/operations.test.mjs test/files.test.mjs test/adapters.test.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "better-auth": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "re2js": "^2.8.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

# Local development values. Replace secrets before exposing any service.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-local-password
# Host port for local Postgres access; keep the port in DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atlas:replace-with-a-local-password@localhost:5432/atlas
BETTER_AUTH_SECRET=replace-this-local-only-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8080
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
BUSINESS_TIMEZONE=Asia/Jakarta
FILE_STORAGE_PATH=./var/files

# Vite serves the UI and proxies /api to the local NestJS server.
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=/api/auth
VITE_API_PROXY_TARGET=http://localhost:3000

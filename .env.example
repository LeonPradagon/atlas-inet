# Local development values. Replace secrets before exposing any service.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-local-password
# Host port for local Postgres access; keep the port in DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atlas:replace-with-a-local-password@localhost:5432/atlas
BETTER_AUTH_SECRET=replace-this-local-only-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8080
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
BUSINESS_TIMEZONE=Asia/Jakarta
FILE_STORAGE_PATH=./var/files
# Optional approved internal adapters. Missing provider produces an explicit unavailable status.
# GEOCODING_INTERNAL_URL=http://internal-provider/geocode
# Native Photon self-hosted; choose this OR GEOCODING_INTERNAL_URL, not both.
# PHOTON_INTERNAL_URL=http://127.0.0.1:2322
# Temporary individual-analysis dev only; sends address to Komoot Photon over internet.
# Never use customer/production addresses; bulk/import does not use this provider.
# PHOTON_PUBLIC_DEV_URL=https://photon.komoot.io
# GEOCODING_DATASET_VERSION=photon-indonesia:<source-dump-checksum>
# Local GraphHopper gateway; run `npm run routing:start` on a capable host.
# ROUTING_INTERNAL_URL=http://127.0.0.1:2323/route
# Set URL to privately reachable gateway address when backend runs in Docker.
# Worker serializes requests; adjust only against the approved provider quota.
WORKER_INTERVAL_MS=1000

# Vite serves the UI and proxies /api to the local NestJS server.
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=/api/auth
VITE_API_PROXY_TARGET=http://localhost:3000
